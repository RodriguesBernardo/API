{
  "info": {
    "name": "API Feriados",
    "description": "Coleção de testes da API de feriados brasileiros (nacional, estadual, municipal, ponto facultativo).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:85/API" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Feriado nacional (Ano Novo 2026)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/feriado?data=2026-01-01",
          "host": ["{{baseUrl}}"],
          "path": ["feriado"],
          "query": [{ "key": "data", "value": "2026-01-01" }]
        }
      }
    },
    {
      "name": "Dia comum (não feriado)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/feriado?data=2026-01-05",
          "host": ["{{baseUrl}}"],
          "path": ["feriado"],
          "query": [{ "key": "data", "value": "2026-01-05" }]
        }
